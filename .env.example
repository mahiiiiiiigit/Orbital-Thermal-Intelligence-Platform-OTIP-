# =============================================================================
# NASA FIRMS API SATELLITE CONFIGURATION
# =============================================================================
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Default bounding box for India (min_lon,min_lat,max_lon,max_lat)
FIRMS_BBOX=68.1,6.7,97.4,35.5

# Time window in days (strictly 1 to 5 for NASA Area API)
FIRMS_DAYS=3

# Satellite sensor source: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Cache TTL in seconds (15 minutes to preserve NASA quota)
FIRMS_CACHE_TTL_SECONDS=900


# =============================================================================
# OPENROUTE SERVICE / MAP ROUTING API KEY
# =============================================================================
# Get your free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_map_key_here
OPENROUTE_MAP_KEY=your_openrouteservice_map_key_here


# =============================================================================
# CARTO BASEMAP RASTER TILE API KEY
# =============================================================================
# Get your CARTO raster key from CARTO developer console
CARTO_API_KEY=your_carto_basemap_key_here
VITE_CARTO_KEY=your_carto_basemap_key_here
