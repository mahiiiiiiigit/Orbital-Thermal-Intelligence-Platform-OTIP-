# Copy this file to .env for local development only. Never commit real API keys.
# In Render/Vercel, set these values in the respective service dashboards.

# =============================================================================
# NASA FIRMS API SATELLITE CONFIGURATION
# =============================================================================
# Get your free MAP key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Omit the key to use the application's demo-data fallback.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Default bounding box for India (min_lon,min_lat,max_lon,max_lat)
FIRMS_BBOX=68.1,6.7,97.4,35.5

# Time window in days (strictly 1 to 5 for NASA Area API)
FIRMS_DAYS=3

# Satellite sensor source: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Cache TTL in seconds (15 minutes to preserve NASA quota)
FIRMS_CACHE_TTL_SECONDS=900

# =============================================================================
# OPENROUTE SERVICE / MAP ROUTING API KEY
# =============================================================================
# Get your free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_map_key_here
OPENROUTE_MAP_KEY=your_openrouteservice_map_key_here

# =============================================================================
# MAPTILER BASEMAP API KEY
# =============================================================================
# Create a browser-restricted key at https://cloud.maptiler.com/account/keys/
# In Vercel, set this as an environment variable; it is embedded in the browser build.
VITE_MAPTILER_KEY=your_maptiler_key_here

# =============================================================================
# PRODUCTION & DEPLOYMENT SETTINGS
# =============================================================================
# Server Port (automatically supplied by Render / Railway / Fly.io)
PORT=8000

# Docker Compose Port Mappings (if deploying via Docker)
BACKEND_PORT=8000
FRONTEND_PORT=80

# Frontend production build: set this in Vercel to your public Render backend URL.
# Example: https://otip-backend.onrender.com
# Use http://localhost:8000 for local development.
VITE_API_BASE_URL=http://localhost:8000

# Backend production CORS: set this in Render to your allowed frontend origins.
# Supports comma-separated origins or '*' for public access.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Optional regex to automatically permit Vercel preview environments (defaults to r"^https:\/\/.*\.vercel\.app$")
FRONTEND_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
