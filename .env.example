# NASA FIRMS API Configuration for ThermalWatch
# Register for a free NASA FIRMS MAP_KEY here:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/

# Paste your 32-character hex key below:
FIRMS_MAP_KEY=

# Default bounding box (min_lon,min_lat,max_lon,max_lat)
# Default: India Region [68.1, 6.7, 97.4, 35.5]
# Jamnagar Industrial Hub: 69.5,22.0,71.0,23.0
# NCR Industrial Belt: 76.5,28.2,77.8,29.0
FIRMS_BBOX=68.1,6.7,97.4,35.5

# Country code (ISO3) alternative to BBOX: IND
FIRMS_COUNTRY=IND

# Time window in days (1 to 10)
FIRMS_DAYS=3

# Satellite source: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT

# In-memory and disk cache TTL in seconds (15 mins default to protect API quota)
FIRMS_CACHE_TTL_SECONDS=900
